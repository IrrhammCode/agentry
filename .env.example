# ==============================================================================
# AGENTRY ENVIRONMENT CONFIGURATION
# ==============================================================================

# Prior Labs API Key (Free tier available at https://platform.priorlabs.ai)
PRIORLABS_API_KEY=your_priorlabs_api_key_here

# Local LLM Configuration (Ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# Cloud LLM Fallback (Optional, e.g. Google Gemini or OpenAI)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Agentry Mode: "local" (default) or "cloud"
AGENTRY_MODE=local
