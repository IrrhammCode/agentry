# ==============================================================================
# AGENTRY ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' and populate your secret keys:
#     cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRIOR LABS TabPFN-3.5 CONFIGURATION
# ------------------------------------------------------------------------------
# Your official TabPFN / Prior Labs API token from https://priorlabs.ai
# If left blank, Agentry will automatically engage its high-fidelity local tabular
# engine so all demos, CLIs, and dashboards run out-of-the-box!
TABPFN_TOKEN=

# Enable TabPFN-3.5 Thinking Mode for deep tabular test-time reasoning (true / false)
TABPFN_THINKING_MODE=true

# Number of estimators for TabPFN ensemble predictions
TABPFN_N_ESTIMATORS=8


# ------------------------------------------------------------------------------
# 2. SENTRY REASONING PROVIDER SELECTION
# ------------------------------------------------------------------------------
# Options:
#   - auto   : Uses Groq if GROQ_API_KEYS is populated, else falls back to local
#              Ollama SLM (Qwen 2.5), else falls back to deterministic rule engine.
#   - groq   : Forces Groq cloud inference with automatic key pool rotation.
#   - ollama : Forces 100% local edge inference (zero prompt data leaves localhost).
#   - rule   : Uses deterministic rule-based heuristic sentry (instantaneous).
SENTRY_PROVIDER=auto


# ------------------------------------------------------------------------------
# 3. GROQ CLOUD REASONING (MULTI-KEY ROTATION POOL)
# ------------------------------------------------------------------------------
# You can supply a single key or multiple keys separated by commas.
# Agentry automatically rotates requests round-robin across all provided keys,
# and automatically fails over to the next key if a 429 Rate Limit occurs!
# Example with 7 rotating keys:
# GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3,gsk_key4,gsk_key5,gsk_key6,gsk_key7
GROQ_API_KEYS=

# Preferred Groq model (e.g., llama-3.3-70b-versatile, llama-3.1-8b-instant, qwen-qwq-32b)
GROQ_MODEL=llama-3.3-70b-versatile

# Groq API Base URL
GROQ_BASE_URL=https://api.groq.com/openai/v1


# ------------------------------------------------------------------------------
# 4. LOCAL EDGE SLM (OLLAMA PRIVACY-FIRST MODE)
# ------------------------------------------------------------------------------
# Local Ollama endpoint for 100% zero-leakage prompt privacy
OLLAMA_BASE_URL=http://localhost:11434/v1

# Installed local Ollama model (e.g., qwen2.5:3b, qwen2.5:7b, llama3.2:3b)
SENTRY_MODEL=qwen2.5:3b


# ------------------------------------------------------------------------------
# 5. AUTONOMOUS GUARDRAIL INTERVENTION THRESHOLDS
# ------------------------------------------------------------------------------
# TabPFN failure probability threshold (0.0 to 1.0) to trigger PAUSE (human review)
RISK_THRESHOLD_PAUSE=0.60

# TabPFN failure probability threshold (0.0 to 1.0) to trigger autonomous KILL
RISK_THRESHOLD_KILL=0.85

# Projected session cost ($ USD) warning threshold
COST_THRESHOLD_WARNING_USD=1.00

# Hard session budget limit ($ USD) to trigger autonomous KILL
COST_THRESHOLD_KILL_USD=2.50

# Jaccard repetition score (0.0 to 1.0) to trigger loop KILL
REPETITION_SCORE_KILL=0.85

# Consecutive tool failure streak to trigger loop KILL
ERROR_STREAK_KILL=5
